# Copy to .env and fill in. .env is gitignored — never commit the real key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the per-agent models (defaults shown)
TRIAGE_MODEL=claude-haiku-4-5
FIXER_MODEL=claude-sonnet-4-6
CRITIC_MODEL=claude-opus-4-8

# Optional: Publer API (only needed for the real lookup_media tool;
# the interview build uses a mocked fixture and does not require this).
PUBLER_API_TOKEN=
PUBLER_WORKSPACE_ID=
